{
  "name": "xander-zaozao-xiaban",
  "version": "2.10.0",
  "description": "Xander（自用）早早下班小助手：给亚马逊个人卖家用的本地运营插件，支持 DSH、Claude 和 Codex（GPT）。",
  "type": "module",
  "license": "MIT",
  "main": "./dsh/index.js",
  "icon": "assets/icon.svg",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json",
    "./settings": "./dsh/settings.js",
    "./client": "./dsh/client.js",
    "./settings/locale/*.json": "./dsh/locale/*.json",
    "./settings/icon": "./assets/icon.svg",
    "./locale/*.json": "./dsh/locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "bin": {
    "xander": "cli/xander.js"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": "^0.2.2-rc.3"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:dsh": "node --test test/dsh.test.js",
    "test:py": "for f in skills/*/scripts/run_regression_tests.py; do python3 \"$f\" || exit 1; done",
    "check:version": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add plugin.json .claude-plugin/plugin.json .codex-plugin/plugin.json README.md docs/dsh.md",
    "mcp": "node server/index.js",
    "panel": "node cli/xander.js panel",
    "setup": "node cli/xander.js setup",
    "doctor": "node cli/xander.js doctor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gx18391303625-afk/xander-zaozao-xiaban.git"
  },
  "keywords": [
    "amazon",
    "seller",
    "sp-api",
    "amazon-ads",
    "mcp",
    "claude",
    "codex",
    "plugin",
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "files": [
    "dsh",
    "scripts/sync-plugin.mjs",
    "cli",
    "lib",
    "server",
    "panel",
    "skills",
    "docs",
    "examples",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "assets"
  ]
}
