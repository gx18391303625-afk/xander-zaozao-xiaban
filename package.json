{
  "name": "xander-zaozao-xiaban",
  "version": "2.5.1",
  "description": "Xander（自用）早早下班小助手：给亚马逊个人卖家用的本地运营插件，支持 DSH、Claude 和 Codex（GPT）。",
  "type": "module",
  "license": "MIT",
  "main": "./dsh/index.js",
  "icon": "assets/icon.svg",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./dsh/locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "bin": {
    "xander": "cli/xander.js"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": "^0.2.1-rc.5"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:dsh": "node --test test/dsh.test.js",
    "mcp": "node server/index.js",
    "panel": "node cli/xander.js panel",
    "setup": "node cli/xander.js setup",
    "doctor": "node cli/xander.js doctor"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gx18391303625-afk/xander-zaozao-xiaban.git"
  },
  "keywords": [
    "amazon",
    "seller",
    "sp-api",
    "amazon-ads",
    "mcp",
    "claude",
    "codex",
    "plugin",
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "files": [
    "dsh",
    "scripts/sync-plugin.mjs",
    "cli",
    "lib",
    "server",
    "panel",
    "skills",
    "docs",
    "examples",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "assets"
  ]
}
